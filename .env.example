# 不需要密钥的本地演示模式，不是真实大模型。
LLM_PROVIDER=qwen
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

STORAGE_BACKEND=sqlite
SQLITE_PATH=data/agent_comm.sqlite3
REDIS_URL=redis://localhost:6379/0
ENABLE_MCP=true
ENABLE_RAG=true

# local 为确定性的词元哈希向量演示；dashscope 才调用真实 Embedding 模型。
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
RAG_TOP_K=5
RAG_THRESHOLD=0.0
# live 调用真实城市定位/天气 API；mock 仅用于离线演示，回答有模拟标签。
WEATHER_MODE=live

HOST=127.0.0.1
REGISTRY_PORT=8500
ORCHESTRATOR_PORT=5000
MATH_PORT=5001
WEATHER_PORT=5002
GRPC_PORT=50051
REQUEST_TIMEOUT=30
HEARTBEAT_INTERVAL=5
HEARTBEAT_TTL=20

# 独立天气 Agent HTTP 端口
WEATHER_PORT=5002